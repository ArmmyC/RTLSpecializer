{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rtl_source_inventory_row_v0.1.schema.json",
  "title": "RTL source inventory row v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "source_dataset", "source_commit", "license", "design_family", "task_id", "source_prompt_sha256", "reference_rtl_sha256", "testbench_sha256", "support_file_hashes", "top_module", "interface_deterministic", "clock_signal_count", "reset_signal_count", "behavior_categories", "verification_readiness", "readiness_reasons", "duplicate_group", "missing_files", "source_path_identity", "unresolved_dependency_count", "unresolved_package_count", "dependency_analysis_ambiguous", "testbench_top_module_count", "warning_codes"],
  "properties": {
    "schema_version": {"const": "rtl_source_inventory_row_v0.1"},
    "source_id": {"type": "string", "minLength": 1},
    "source_dataset": {"type": "string", "minLength": 1},
    "source_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "license": {"type": ["string", "null"]},
    "design_family": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "source_prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reference_rtl_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "testbench_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "support_file_hashes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "top_module": {"type": ["string", "null"]},
    "interface_deterministic": {"type": "boolean"},
    "clock_signal_count": {"type": "integer", "minimum": 0},
    "reset_signal_count": {"type": "integer", "minimum": 0},
    "behavior_categories": {"type": "array", "items": {"type": "string"}},
    "verification_readiness": {"type": "string"},
    "readiness_reasons": {"type": "array", "items": {"type": "string"}},
    "duplicate_group": {"type": ["string", "null"]},
    "missing_files": {"type": "array", "items": {"type": "string"}},
    "source_path_identity": {"type": "string", "minLength": 1},
    "unresolved_dependency_count": {"type": ["integer", "null"], "minimum": 0},
    "unresolved_package_count": {"type": ["integer", "null"], "minimum": 0},
    "dependency_analysis_ambiguous": {"type": "boolean"},
    "testbench_top_module_count": {"type": ["integer", "null"], "minimum": 0},
    "warning_codes": {"type": "array", "items": {"type": "string"}}
  }
}
