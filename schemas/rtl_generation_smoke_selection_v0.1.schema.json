{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rtl_generation_smoke_selection_v0.1.schema.json",
  "title": "RTL generation smoke selection v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "inventory_schema_version", "inventory_sha256", "split_sha256", "split", "requested_count", "eligible_training_count", "selected_count", "selection_algorithm", "requested_categories", "covered_categories", "missing_categories", "rows", "errors"],
  "properties": {
    "schema_version": {"const": "rtl_generation_smoke_selection_v0.1"},
    "inventory_schema_version": {"const": "rtl_source_inventory_row_v0.1"},
    "inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "base_inventory_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "correction_manifest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "split_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "split": {"const": "train"},
    "requested_count": {"const": 5},
    "eligible_training_count": {"type": "integer", "minimum": 0},
    "selected_count": {"const": 5},
    "selection_algorithm": {"const": "coverage_greedy_source_id_tiebreak_v1"},
    "requested_categories": {"type": "array", "items": {"type": "string"}},
    "covered_categories": {"type": "array", "items": {"type": "string"}},
    "missing_categories": {"type": "array", "items": {"type": "string"}},
    "rows": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object"}},
    "errors": {"type": "array", "items": {"type": "string"}},
    "ok": {"type": "boolean"},
    "ids_output": {"type": "string"},
    "report_output": {"type": "string"}
  }
}
