{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rtl_generation_attempt_v0.1.schema.json",
  "title": "Evidence-aware RTL generation attempt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "task_id", "source_id", "attempt", "top_module", "candidate_sha256", "verification_profile", "accepted", "failure_category", "checks", "mismatch_summary", "diagnostics", "toolchain"],
  "$defs": {
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "passed", "reason"],
      "properties": {
        "attempted": {"type": "boolean"},
        "passed": {"type": ["boolean", "null"]},
        "reason": {"type": ["string", "null"], "enum": [null, "not_requested", "tool_unavailable", "compile_failure", "functional_mismatch", "simulation_result_missing", "simulation_failure", "timeout", "internal_error", "partial_failure"]}
      },
      "anyOf": [
        {"properties": {"attempted": {"const": true}, "passed": {"type": "boolean"}, "reason": {"const": null}}},
        {"properties": {"attempted": {"const": false}, "passed": {"const": null}, "reason": {"type": "string", "minLength": 1}}}
      ]
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compile", "simulation", "lint", "synthesis"],
      "properties": {
        "compile": {"type": "object", "additionalProperties": false, "required": ["candidate"], "properties": {"candidate": {"$ref": "#/$defs/status"}}},
        "simulation": {"type": "object", "additionalProperties": false, "required": ["candidate_passes"], "properties": {"candidate_passes": {"$ref": "#/$defs/status"}}},
        "lint": {"type": "object", "additionalProperties": false, "required": ["candidate"], "properties": {"candidate": {"$ref": "#/$defs/status"}}},
        "synthesis": {"type": "object", "additionalProperties": false, "required": ["candidate"], "properties": {"candidate": {"$ref": "#/$defs/status"}}}
      }
    },
    "mismatch_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "reported_counts", "reported_sample_counts", "maximum_count", "timeout_reported"],
      "properties": {
        "contract": {"const": "mismatch_count_v1"},
        "reported_counts": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "reported_sample_counts": {"type": "array", "items": {"type": ["integer", "null"], "minimum": 0}},
        "maximum_count": {"type": ["integer", "null"], "minimum": 0},
        "timeout_reported": {"type": "boolean"}
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "version"],
      "properties": {"available": {"type": "boolean"}, "version": {"type": ["string", "null"], "maxLength": 256}}
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iverilog", "vvp", "verilator", "yosys"],
      "properties": {"iverilog": {"$ref": "#/$defs/tool"}, "vvp": {"$ref": "#/$defs/tool"}, "verilator": {"$ref": "#/$defs/tool"}, "yosys": {"$ref": "#/$defs/tool"}}
    }
  },
  "properties": {
    "schema_version": {"const": "rtl_generation_attempt_v0.1"},
    "candidate_id": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_$]*_attempt_[0-9]{2}$"},
    "task_id": {"type": "string", "minLength": 1, "pattern": "^[^\\s\\u0000]+$"},
    "source_id": {"type": "string", "minLength": 1, "pattern": "^[^\\s\\u0000]+$"},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 4},
    "top_module": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"},
    "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verification_profile": {"const": "verilog_eval_mismatch_v1"},
    "accepted": {"type": "boolean"},
    "failure_category": {"enum": ["passed", "tool_unavailable", "compile_failure", "functional_mismatch", "simulation_result_missing", "simulation_failure", "timeout", "internal_error", "partial_failure"]},
    "checks": {"$ref": "#/$defs/checks"},
    "mismatch_summary": {"$ref": "#/$defs/mismatch_summary"},
    "diagnostics": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 4096}},
    "toolchain": {"$ref": "#/$defs/toolchain"}
  }
}
