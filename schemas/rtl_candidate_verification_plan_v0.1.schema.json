{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rtl_candidate_verification_plan_v0.1.schema.json",
  "title": "RTL candidate verification plan v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "task_id", "source_id", "attempt", "top_module", "verification_profile", "testbench_top", "simulation_result_contract", "requested_checks", "workspace_paths", "expected_hashes"],
  "$defs": {
    "relative_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hash_record": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/relative_path"}, "sha256": {"$ref": "#/$defs/sha256"}}}
  },
  "properties": {
    "schema_version": {"const": "rtl_candidate_verification_plan_v0.1"},
    "candidate_id": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_$]*_attempt_[0-9]{2}$"},
    "task_id": {"type": "string", "minLength": 1, "pattern": "^[^\\s\\u0000]+$"},
    "source_id": {"type": "string", "minLength": 1, "pattern": "^[^\\s\\u0000]+$"},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 4},
    "top_module": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"},
    "verification_profile": {"const": "verilog_eval_mismatch_v1"},
    "testbench_top": {"const": "tb"},
    "simulation_result_contract": {"const": "mismatch_count_v1"},
    "requested_checks": {"type": "object", "additionalProperties": false, "required": ["compile", "simulation", "lint", "synthesis"], "properties": {"compile": {"const": true}, "simulation": {"const": true}, "lint": {"const": false}, "synthesis": {"const": false}}},
    "workspace_paths": {"type": "object", "additionalProperties": false, "required": ["candidate_rtl_path", "testbench_path", "support_files"], "properties": {"candidate_rtl_path": {"$ref": "#/$defs/relative_path"}, "testbench_path": {"$ref": "#/$defs/relative_path"}, "support_files": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/relative_path"}}}},
    "expected_hashes": {"type": "object", "additionalProperties": false, "required": ["candidate_rtl_sha256", "testbench_sha256", "support_files"], "properties": {"candidate_rtl_sha256": {"$ref": "#/$defs/sha256"}, "testbench_sha256": {"$ref": "#/$defs/sha256"}, "support_files": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/hash_record"}}}}
  }
}
