{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rtl_asset_qualification_authorization_v0.1.schema.json",
  "title": "RTL asset qualification execution authorization",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "status",
    "authorization_scope",
    "source_commit",
    "source_tree_sha256",
    "frozen_split_sha256",
    "selection_ids_sha256",
    "correction_manifest_sha256",
    "selected_source_ids",
    "case_count",
    "positive_case_count",
    "negative_case_count",
    "reference_rtl_supplied",
    "support_file_count",
    "runner",
    "exact_command",
    "authorized_invocations"
  ],
  "properties": {
    "schema_version": {"const": "rtl_asset_qualification_execution_authorization_v0.1"},
    "run_id": {"const": "pilot_004_assetfix_v003"},
    "status": {"const": "authorized_once"},
    "authorization_scope": {"const": "qualification_only"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "frozen_split_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selection_ids_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "correction_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selected_source_ids": {"type": "array", "minItems": 20, "maxItems": 20, "uniqueItems": true},
    "case_count": {"const": 60},
    "positive_case_count": {"const": 20},
    "negative_case_count": {"const": 40},
    "reference_rtl_supplied": {"const": false},
    "support_file_count": {"const": 0},
    "runner": {"type": "object"},
    "exact_command": {"type": "array", "minItems": 1},
    "authorized_invocations": {"const": 1}
  },
  "additionalProperties": true
}
