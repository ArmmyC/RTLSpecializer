{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rtl_generation_human_review_v0.2.schema.json",
  "title": "RTL generation human review v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "package_tree_sha256",
    "reviewer",
    "review_status",
    "overall_decision",
    "promotion_allowed",
    "row_count",
    "rows",
    "review_exceptions"
  ],
  "properties": {
    "schema_version": {"const": "rtl_generation_human_review_v0.2"},
    "package_id": {"type": "string", "minLength": 1},
    "package_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_type", "reviewer_id", "reviewed_at", "review_method"],
      "properties": {
        "reviewer_type": {"const": "human"},
        "reviewer_id": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "review_method": {"const": "manual_row_review"}
      }
    },
    "review_status": {"const": "human_reviewed"},
    "overall_decision": {
      "enum": [
        "approved_for_experimental_training",
        "changes_requested",
        "rejected"
      ]
    },
    "promotion_allowed": {"const": false},
    "row_count": {"const": 5},
    "review_exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "code", "disposition", "details"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "code": {"const": "normalized_metadata_mismatch"},
          "disposition": {"const": "human_accepted_for_experimental_training"},
          "details": {"type": "string", "minLength": 1}
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "task_id",
          "candidate_id",
          "candidate_sha256",
          "specification_preserved",
          "interface_correct",
          "rtl_behavior_consistent",
          "training_quality_acceptable",
          "private_content_detected",
          "assistant_rtl_only",
          "metadata_accurate",
          "review_exception_acknowledged",
          "review_outcome",
          "review_notes"
        ],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "task_id": {"type": "string", "minLength": 1},
          "candidate_id": {"type": "string", "minLength": 1},
          "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "specification_preserved": {"const": true},
          "interface_correct": {"const": true},
          "rtl_behavior_consistent": {"const": true},
          "training_quality_acceptable": {"const": true},
          "private_content_detected": {"const": false},
          "assistant_rtl_only": {"const": true},
          "metadata_accurate": {"type": "boolean"},
          "review_exception_acknowledged": {"type": "boolean"},
          "review_outcome": {
            "enum": [
              "approved_for_experimental_training",
              "changes_requested",
              "rejected"
            ]
          },
          "review_notes": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
