{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rtl_teacher_repair_packet_v0.1.schema.json",
  "title": "Manual RTL teacher repair packet v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "packet_kind", "target_attempt", "row_count", "rows"],
  "properties": {
    "schema_version": {"const": "rtl_teacher_repair_packet_v0.1"}, "packet_id": {"type": "string"}, "packet_kind": {"const": "repair"}, "target_attempt": {"type": "integer", "minimum": 2, "maximum": 4}, "row_count": {"type": "integer", "minimum": 1},
    "rows": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["task", "previous_candidate", "verification_feedback"], "properties": {"task": {"$ref": "rtl_generation_task_v0.1.schema.json"}, "previous_candidate": {"$ref": "rtl_teacher_candidate_v0.1.schema.json"}, "verification_feedback": {"type": "object", "additionalProperties": false, "required": ["failure_category", "compile_reason", "simulation_reason", "mismatch_summary", "diagnostics"], "properties": {"failure_category": {"type": "string"}, "compile_reason": {"type": ["string", "null"]}, "simulation_reason": {"type": ["string", "null"]}, "mismatch_summary": {"type": "object"}, "diagnostics": {"type": "array", "items": {"type": "string", "maxLength": 4096}}}}}}}
  }
}
