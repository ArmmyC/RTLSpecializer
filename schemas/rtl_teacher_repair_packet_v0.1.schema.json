{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rtl_teacher_repair_packet_v0.1.schema.json",
  "title": "Manual RTL teacher repair packet v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "packet_kind", "target_attempt", "row_count", "rows"],
  "properties": {
    "schema_version": {"const": "rtl_teacher_repair_packet_v0.1"},
    "packet_id": {"type": "string", "pattern": "^rtl_teacher_repair_batch_[0-9]{4}_[0-9a-f]{12}$"},
    "packet_kind": {"const": "repair"},
    "target_attempt": {"type": "integer", "minimum": 2, "maximum": 4},
    "row_count": {"type": "integer", "minimum": 1},
    "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/row"}}
  },
  "$defs": {
    "mismatch_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["contract", "reported_counts", "reported_sample_counts", "maximum_count", "timeout_reported"],
      "properties": {
        "contract": {"const": "mismatch_count_v1"},
        "reported_counts": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "reported_sample_counts": {"type": "array", "items": {"type": ["integer", "null"], "minimum": 0}},
        "maximum_count": {"type": ["integer", "null"], "minimum": 0},
        "timeout_reported": {"type": "boolean"}
      }
    },
    "row": {
      "type": "object", "additionalProperties": false,
      "required": ["task", "previous_candidate", "verification_feedback"],
      "properties": {
        "task": {"$ref": "rtl_generation_task_v0.1.schema.json"},
        "previous_candidate": {"$ref": "rtl_teacher_candidate_v0.1.schema.json"},
        "verification_feedback": {
          "type": "object", "additionalProperties": false,
          "required": ["failure_category", "compile_reason", "simulation_reason", "mismatch_summary", "diagnostics"],
          "properties": {
            "failure_category": {"enum": ["tool_unavailable", "compile_failure", "functional_mismatch", "simulation_result_missing", "simulation_failure", "timeout", "internal_error", "partial_failure"]},
            "compile_reason": {"type": ["string", "null"], "enum": [null, "tool_unavailable", "compile_failure", "functional_mismatch", "simulation_result_missing", "simulation_failure", "timeout", "internal_error", "partial_failure"]},
            "simulation_reason": {"type": ["string", "null"], "enum": [null, "tool_unavailable", "compile_failure", "functional_mismatch", "simulation_result_missing", "simulation_failure", "timeout", "internal_error", "partial_failure"]},
            "mismatch_summary": {"$ref": "#/$defs/mismatch_summary"},
            "diagnostics": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 4096}}
          }
        }
      }
    }
  }
}
