{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rtl_teacher_candidate_v0.1.schema.json",
  "title": "RTL teacher candidate v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "top_module", "language", "rtl", "implementation_summary", "assumptions"],
  "properties": {
    "schema_version": {"const": "rtl_teacher_candidate_v0.1"},
    "task_id": {"type": "string", "minLength": 1},
    "top_module": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"},
    "language": {"const": "systemverilog"},
    "rtl": {"type": "string", "minLength": 1},
    "implementation_summary": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "items": {"type": "string"}}
  }
}
