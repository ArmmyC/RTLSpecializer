{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rtl_verification_asset_correction_selection_v0.2.schema.json",
  "title": "RTL verification asset correction selection v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inventory_schema_version",
    "source_dataset",
    "source_commit",
    "source_tree_sha256",
    "source_acquisition_sha256",
    "base_inventory_sha256",
    "base_split_sha256",
    "correction_version",
    "batch_id",
    "split",
    "excluded_source_ids",
    "requested_count",
    "selected_count",
    "selection_algorithm",
    "classification_basis",
    "diversity_targets",
    "diversity_achieved",
    "unmet_diversity_targets",
    "selection_ids_sha256",
    "rows",
    "errors"
  ],
  "properties": {
    "schema_version": {"const": "rtl_verification_asset_correction_selection_v0.2"},
    "inventory_schema_version": {"const": "rtl_source_inventory_row_v0.1"},
    "ok": {"type": "boolean"},
    "source_dataset": {"const": "VerilogEval"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_acquisition_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "base_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "base_split_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "correction_version": {"type": "string", "minLength": 1},
    "batch_id": {"type": "string", "minLength": 1},
    "split": {"const": "train"},
    "excluded_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "requested_count": {"const": 20},
    "selected_count": {"const": 20},
    "selection_algorithm": {"type": "string", "minLength": 1},
    "classification_basis": {"const": "public_specification_and_interface_metadata"},
    "diversity_targets": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}},
    "diversity_achieved": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "unmet_diversity_targets": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "selection_ids_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rows": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "selection_order",
          "source_id",
          "task_id",
          "split",
          "current_readiness",
          "blocking_reason",
          "selection_reason",
          "selection_role",
          "design_family",
          "behavior_categories",
          "diversity_tags",
          "source_prompt_sha256",
          "top_module",
          "interface_deterministic",
          "clock_signal_count",
          "reset_signal_count"
        ],
        "properties": {
          "selection_order": {"type": "integer", "minimum": 1, "maximum": 20},
          "source_id": {"type": "string", "minLength": 1},
          "task_id": {"type": "string", "minLength": 1},
          "split": {"const": "train"},
          "current_readiness": {"const": "needs_testbench"},
          "blocking_reason": {"const": "reference_only_dependency"},
          "selection_reason": {"const": "bounded public-spec diversity correction batch"},
          "selection_role": {"type": "string", "minLength": 1},
          "design_family": {"type": "string", "minLength": 1},
          "behavior_categories": {"type": "array", "items": {"type": "string"}},
          "diversity_tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "source_prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "top_module": {"const": "TopModule"},
          "interface_deterministic": {"const": true},
          "clock_signal_count": {"type": "integer", "minimum": 0},
          "reset_signal_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "errors": {"type": "array", "maxItems": 0, "items": {"type": "string"}}
  }
}
