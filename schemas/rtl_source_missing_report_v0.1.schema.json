{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rtl_source_missing_report_v0.1.schema.json",
  "title": "RTL source missing-file report v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_commit", "inventory_sha256", "total_rows", "rows_with_missing_files", "missing_file_counts", "rows"],
  "properties": {
    "schema_version": {"const": "rtl_source_missing_report_v0.1"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "total_rows": {"type": "integer", "minimum": 0},
    "rows_with_missing_files": {"type": "integer", "minimum": 0},
    "missing_file_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "rows": {"type": "array", "items": {"type": "object"}}
  }
}
