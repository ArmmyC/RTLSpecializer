{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rtl_teacher_candidate_record_v0.1.schema.json",
  "title": "Validated manual RTL teacher candidate record v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "task_id", "source_id", "attempt", "packet_id", "candidate_sha256", "candidate"],
  "properties": {
    "schema_version": {"const": "rtl_teacher_candidate_record_v0.1"},
    "candidate_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 4},
    "packet_id": {"type": "string", "minLength": 1},
    "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate": {"$ref": "rtl_teacher_candidate_v0.1.schema.json"}
  }
}
