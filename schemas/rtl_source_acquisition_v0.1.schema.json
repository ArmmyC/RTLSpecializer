{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rtl_source_acquisition_v0.1.schema.json",
  "title": "RTL source acquisition manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_name", "repository", "source_commit", "acquired_at", "local_root", "input", "license_files", "source_tree_sha256", "dirty_checkout", "symlink_count", "row_count", "errors"],
  "properties": {
    "schema_version": {"const": "rtl_source_acquisition_v0.1"},
    "dataset_name": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "acquired_at": {"type": "string", "minLength": 1},
    "local_root": {"type": "string", "minLength": 1},
    "input": {"type": "string", "minLength": 1},
    "license_files": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "source_tree_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "dirty_checkout": {"type": ["boolean", "null"]},
    "symlink_count": {"type": "integer", "minimum": 0},
    "row_count": {"type": ["integer", "null"], "minimum": 0},
    "errors": {"type": "array", "items": {"type": "string"}}
  }
}
