{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rtl_verification_asset_v0.1.schema.json",
  "title": "RTL verification asset v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "source_id", "top_module", "verification_readiness", "readiness_reasons", "reference_rtl_path", "testbench_path", "support_files", "input_hashes"],
  "properties": {
    "schema_version": {"const": "rtl_verification_asset_v0.1"},
    "task_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "top_module": {"type": ["string", "null"], "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"},
    "verification_readiness": {"enum": ["executable_ready", "needs_testbench", "needs_interface_review", "ambiguous_specification", "structural_only", "license_blocked", "invalid"]},
    "readiness_reasons": {"type": "array", "items": {"type": "string"}},
    "reference_rtl_path": {"type": ["string", "null"], "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "testbench_path": {"type": ["string", "null"], "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "support_files": {"type": "array", "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}},
    "input_hashes": {
      "type": "object", "additionalProperties": false,
      "required": ["source_prompt_sha256", "reference_rtl_sha256", "testbench_sha256", "support_files"],
      "properties": {
        "source_prompt_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "reference_rtl_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "testbench_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "support_files": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}
      }
    }
  }
}
