{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rtl_teacher_generation_packet_v0.1.schema.json",
  "title": "Manual RTL teacher generation packet v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "packet_kind", "target_attempt", "row_count", "rows"],
  "properties": {
    "schema_version": {"const": "rtl_teacher_generation_packet_v0.1"},
    "packet_id": {"type": "string", "minLength": 1},
    "packet_kind": {"const": "initial"},
    "target_attempt": {"const": 1},
    "row_count": {"type": "integer", "minimum": 1},
    "rows": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["task"], "properties": {"task": {"$ref": "rtl_generation_task_v0.1.schema.json"}}}}
  }
}
