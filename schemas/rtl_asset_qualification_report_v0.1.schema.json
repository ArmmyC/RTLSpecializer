{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rtl_asset_qualification_report_v0.1.schema.json",
  "title": "RTL asset qualification report",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "source_commit",
    "source_tree_sha256",
    "frozen_split_sha256",
    "correction_version",
    "qualification_manifest_sha256",
    "qualification_evidence_sha256",
    "qualification_sidecar_sha256",
    "selected_tasks",
    "qualified_tasks",
    "failed_qualification",
    "reference_rtl_supplied",
    "support_file_count",
    "rows",
    "errors",
    "qualification_passed"
  ],
  "properties": {
    "schema_version": {"const": "rtl_asset_qualification_report_v0.1"},
    "run_id": {"const": "pilot_004_assetfix_v003"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "frozen_split_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "correction_version": {"const": "assetfix_v003"},
    "qualification_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "qualification_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "qualification_sidecar_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selected_tasks": {"const": 20},
    "qualified_tasks": {"type": "integer", "minimum": 0, "maximum": 20},
    "failed_qualification": {"type": "integer", "minimum": 0, "maximum": 20},
    "reference_rtl_supplied": {"const": false},
    "support_file_count": {"const": 0},
    "rows": {"type": "array", "minItems": 20, "maxItems": 20},
    "errors": {"type": "array"},
    "qualification_passed": {"type": "boolean"}
  },
  "additionalProperties": true
}
